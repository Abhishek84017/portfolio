# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL — used for metadataBase / Open Graph URLs.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically,
# so you only need to set it once a custom domain is added.
NEXT_PUBLIC_SITE_URL=

# Supabase (contact form). Server-only — intentionally not NEXT_PUBLIC_.
# Get both from: supabase status (local) or Project Settings → API (hosted).
SUPABASE_URL=
SUPABASE_ANON_KEY=
