# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL — used for metadataBase / Open Graph URLs.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically,
# so you only need to set it once a custom domain is added.
NEXT_PUBLIC_SITE_URL=

# Contact form email delivery via Resend (primary). Server-only.
# Until you verify a custom domain in Resend, CONTACT_TO_EMAIL must be the email
# your Resend account is registered with (sender is onboarding@resend.dev).
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional, after verifying a domain in Resend, e.g. "Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Supabase (contact form archive — optional). Server-only — intentionally not NEXT_PUBLIC_.
# Get both from: supabase status (local) or Project Settings → API (hosted).
SUPABASE_URL=
SUPABASE_ANON_KEY=
